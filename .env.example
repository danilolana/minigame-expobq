# Server-only. Configure these in Vercel Project Settings and never prefix them with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
RUN_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Server-only administrative access.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Public browser credentials used only to receive Supabase Realtime events.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
